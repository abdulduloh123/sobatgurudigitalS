// Salin potongan ini ke dalam blok match /databases/{database}/documents
// di Firebase Console. Jangan mengganti seluruh aturan website.
//
// Data Samples (sampleFiles, sampleTexts, sampleIndex, driveDownloadLogs) hanya
// dibaca dan ditulis oleh server, jadi browser tidak perlu aturan apa pun untuknya.
// Jika aturan lama untuk driveSamples / driveDownloadLogs masih ada, boleh dihapus.

match /sampleUsers/{userId} {
  allow read: if request.auth != null && request.auth.uid == userId;
  allow write: if false;
}
