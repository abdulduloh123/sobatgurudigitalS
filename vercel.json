{
  "functions": {
    "api/samples/*.ts": {
      "maxDuration": 60
    },
    "api/admin/samples/*.ts": {
      "maxDuration": 60
    },
    "api/meta.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/meta/:action",
      "destination": "/api/meta?action=:action"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
