rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sampleRoleIs(role) {
      return request.auth != null
        && exists(/databases/$(database)/documents/sampleUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sampleUsers/$(request.auth.uid)).data.role == role;
    }

    // Staff credentials are read and changed only by the authenticated server.
    // The server migrates legacy passwords to hashes and removes password fields.
    match /artifacts/{appId}/public/data/usersData/{userId} {
      allow read, write: if false;
    }

    // Existing dashboard data remains available to signed-in app sessions.
    match /artifacts/{appId}/public/data/{collectionName}/{document=**} {
      allow read, write: if request.auth != null && collectionName != 'usersData';
    }

    // Public landing pages are readable by visitors; changes require admin login.
    match /artifacts/{appId}/metaLandingPages/{slug} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'GANTI_EMAIL_ADMIN@gmail.com';
    }

    match /waGroups/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'GANTI_EMAIL_ADMIN@gmail.com';
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counter', 'hits', 'total'])
        && request.resource.data.total == resource.data.total + 1
        && (request.resource.data.counter == resource.data.counter
          || request.resource.data.counter == resource.data.counter + 1);
    }

    match /settings/meta {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'GANTI_EMAIL_ADMIN@gmail.com';
    }

    // Users may read their own role, but only a project owner can create/edit
    // these documents from Firebase Console.
    match /sampleUsers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Admin manages the private catalog. CS receives only a filtered response
    // from the backend, without Google Drive file IDs.
    match /driveSamples/{sampleId} {
      allow read: if sampleRoleIs('admin');
      allow create, update, delete: if sampleRoleIs('admin');
    }

    match /driveDownloadLogs/{logId} {
      allow read: if sampleRoleIs('admin');
      allow write: if false;
    }
  }
}

